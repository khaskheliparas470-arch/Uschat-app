# ==========================================
# UsChat Environment Variables Configuration
# ==========================================

# Gemini AI API Key (Required for AI Smart Assistant & Auto-replies)
# Obtain from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY="your_gemini_api_key_here"

# Application Hosted URL (Used for WebRTC signaling, API calls, and callbacks)
# Local Example: http://localhost:5173
# Production Example: https://uschat.vercel.app
VITE_APP_URL="http://localhost:5173"
